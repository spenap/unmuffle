<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="TransChat"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransChat">

        <!-- Router: checks model and navigates to Download or Ready -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Model download screen (first launch) -->
        <activity
            android:name=".DownloadActivity"
            android:exported="false" />

        <!-- Post-download / already-downloaded screen -->
        <activity
            android:name=".ReadyActivity"
            android:exported="false" />

    </application>

</manifest>
