<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Unmuffle"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unmuffle">

        <!-- Router: checks model and navigates to Download or Ready -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Unmuffle.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Model download screen (first launch) -->
        <activity
            android:name=".DownloadActivity"
            android:exported="false" />

        <!-- Post-download / already-downloaded screen -->
        <activity
            android:name=".ReadyActivity"
            android:exported="false" />

        <!-- Share target: transparent, no UI, receives audio shares -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="Unmuffle"
            android:theme="@style/Theme.Unmuffle.Transparent">

            <!-- Intent filter 1: standard audio MIME types (WhatsApp, most apps) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Intent filter 2: octet-stream (Telegram voice messages) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Transcription progress and result screen -->
        <activity
            android:name=".TranscriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.Unmuffle" />

        <!-- Phase 1 smoke test — developer tool, accessed via adb or temporary launcher swap -->
        <activity
            android:name=".SmokeTestActivity"
            android:exported="true"
            android:label="Unmuffle Smoke Test" />

    </application>

</manifest>
