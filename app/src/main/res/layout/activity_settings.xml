<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Settings" />

    <LinearLayout
        android:id="@+id/language_row"
        style="@style/Unmuffle.SettingsRow">

        <TextView
            style="@style/Unmuffle.SettingsTitle"
            android:text="Transcription language" />

        <TextView
            android:id="@+id/language_value"
            style="@style/Unmuffle.SettingsValue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/licences_row"
        style="@style/Unmuffle.SettingsRow">

        <TextView
            style="@style/Unmuffle.SettingsTitle"
            android:text="Licences" />

        <TextView
            style="@style/Unmuffle.SettingsValue"
            android:text="whisper.cpp, the Whisper model and the Android libraries" />
    </LinearLayout>

</LinearLayout>
